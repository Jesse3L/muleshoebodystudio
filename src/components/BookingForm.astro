---
import { site } from '../site';
const webhook = import.meta.env.PUBLIC_BOOKING_WEBHOOK ?? '';
---
<form
  id="booking-form"
  data-webhook={webhook}
  class="rounded-[2rem] bg-bone p-6 shadow-[0_40px_100px_-30px_rgba(0,0,0,.7)] ring-1 ring-white/10 sm:p-9"
  novalidate
>
  <fieldset>
    <legend class="text-sm font-semibold uppercase tracking-[.18em] text-clay">What would you like to book?</legend>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="group relative cursor-pointer rounded-2xl border border-ink/10 bg-bone p-4 transition has-[:checked]:border-ember has-[:checked]:bg-blush/60">
        <input type="radio" name="booking_type" value="Free consultation" class="peer sr-only" checked />
        <span class="block font-display text-lg leading-tight">Free consultation</span>
        <span class="mt-1 block text-sm text-ink/65">First visit — goals, measurements and a plan.</span>
        <span class="absolute right-4 top-4 h-4 w-4 rounded-full border border-ink/25 peer-checked:border-[5px] peer-checked:border-ember"></span>
      </label>
      <label class="group relative cursor-pointer rounded-2xl border border-ink/10 bg-bone p-4 transition has-[:checked]:border-ember has-[:checked]:bg-blush/60">
        <input type="radio" name="booking_type" value="invisa-RED laser session" class="peer sr-only" />
        <span class="block font-display text-lg leading-tight">Laser session</span>
        <span class="mt-1 block text-sm text-ink/65">Time on the invisa-RED for current clients.</span>
        <span class="absolute right-4 top-4 h-4 w-4 rounded-full border border-ink/25 peer-checked:border-[5px] peer-checked:border-ember"></span>
      </label>
    </div>
  </fieldset>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <label class="block text-sm font-medium">First &amp; last name
      <input class="field mt-1.5" name="name" autocomplete="name" required />
    </label>
    <label class="block text-sm font-medium">Phone
      <input class="field mt-1.5" name="phone" type="tel" autocomplete="tel" required />
    </label>
    <label class="block text-sm font-medium sm:col-span-2">Email <span class="text-ink/45">(optional)</span>
      <input class="field mt-1.5" name="email" type="email" autocomplete="email" />
    </label>
    <label class="block text-sm font-medium">Preferred day
      <select class="field mt-1.5" name="preferred_day">
        <option>Any weekday</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option>
      </select>
    </label>
    <label class="block text-sm font-medium">Preferred time
      <select class="field mt-1.5" name="preferred_time">
        <option>Anytime</option><option>Morning</option><option>Lunch hour</option><option>Afternoon</option>
      </select>
    </label>
    <label class="block text-sm font-medium sm:col-span-2">Main goal
      <select class="field mt-1.5" name="goal">
        <option>Weight loss</option>
        <option>Inch loss / body contouring</option>
        <option>Cellulite</option>
        <option>Skin tightening</option>
        <option>Not sure yet — help me decide</option>
      </select>
    </label>
    <label class="block text-sm font-medium sm:col-span-2">Anything we should know? <span class="text-ink/45">(optional)</span>
      <textarea class="field mt-1.5" name="message" rows="3" placeholder="Areas you'd like to work on, schedule notes, questions…"></textarea>
    </label>
    <!-- honeypot -->
    <label class="hidden" aria-hidden="true">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
  </div>

  <button type="submit" class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-full bg-ember px-7 py-4 font-semibold text-white shadow-[0_14px_40px_-12px_rgba(214,38,46,.8)] transition hover:bg-ember-deep focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-ember/30">
    Request my appointment
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <p class="mt-3 text-center text-xs text-ink/55">We'll call or text to confirm your time. Prefer to talk now? Call <a class="underline decoration-ember/40 underline-offset-2" href={site.phoneHref}>{site.phone}</a>.</p>
  <p id="form-status" class="mt-4 hidden rounded-xl p-4 text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const show = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.className = `mt-4 rounded-xl p-4 text-sm ${ok ? 'bg-emerald-50 text-emerald-900' : 'bg-red-50 text-red-900'}`;
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    if (data.company) return; // bot
    if (!data.name?.trim() || !data.phone?.trim()) {
      show('Please add your name and a phone number so we can confirm your time.', false);
      return;
    }
    const webhook = form.dataset.webhook;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.style.opacity = '.7';
    try {
      if (!webhook) throw new Error('no-webhook');
      const res = await fetch(webhook, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, source: 'muleshoebodystudio.com', submitted_at: new Date().toISOString() }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show("You're on the list! We'll reach out shortly to confirm your appointment.", true);
      (window as any).gtag?.('event', 'generate_lead', { booking_type: data.booking_type });
    } catch {
      show('Something went wrong sending your request. Please call (806) 272-4000 and we will get you scheduled.', false);
    } finally {
      btn.disabled = false;
      btn.style.opacity = '';
    }
  });
</script>
