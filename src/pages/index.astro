---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import { site } from '../site';

import device from '../assets/invisa-red-elite-device.png';
import studio from '../assets/invisa-red-elite-studio.jpg';
import consoleImg from '../assets/invisa-red-elite-console.png';
import waist from '../assets/body-contouring-waist.png';
import weight from '../assets/weight-loss.png';
import cellulite from '../assets/cellulite-reduction.png';
import arm from '../assets/skin-tightening-arm.jpg';

const title = 'Red Light Therapy for Weight Loss & Body Contouring in Muleshoe, TX | Muleshoe Body Studio';
const description =
  'Non-invasive fat reduction and inch loss with the FDA-cleared invisa-RED laser — now in Muleshoe, TX. No surgery, no downtime, 15–20 minute sessions. Book a free consultation.';

const faqs = [
  {
    q: 'Does red light therapy really help with weight loss?',
    a: 'Red and infrared laser light can prompt fat cells to release stored lipids, which your body then burns for energy and clears through the lymphatic system. On its own it is not a magic fix — it works best alongside the healthy eating and movement habits we help you build. In the manufacturer\'s double-blind clinical trial, people lost inches with no changes to diet or exercise, and pairing sessions with a plan tends to amplify results.',
  },
  {
    q: 'Is invisa-RED the same as laser lipo?',
    a: 'People often call it "laser lipo," but there is no surgery, no needles and no suction. invisa-RED is a non-invasive, low-level laser you simply lie under. Traditional laser liposuction is a surgical procedure with recovery time; this is closer to a relaxing 20-minute rest with warm light on the treatment area.',
  },
  {
    q: 'Does it hurt? Is there any downtime?',
    a: 'Most clients describe a gentle warmth and find the session relaxing. There is no downtime — you can head back to work, pick up the kids or go to the gym right after.',
  },
  {
    q: 'How many sessions will I need?',
    a: 'It depends on your goal. Body contouring plans usually run two to three sessions a week for several weeks. For larger weight-loss goals, the manufacturer\'s guideline is roughly 24 sessions for the first 20 pounds, then continuing until you reach your goal. We will give you a clear estimate at your free consultation.',
  },
  {
    q: 'How long is each session?',
    a: 'The laser runs 15–20 minutes per area. Plan on about 30 minutes for your visit including check-in and measurements.',
  },
  {
    q: 'When will I see results?',
    a: 'Many people notice a difference in how their clothes fit within the first few sessions. We take measurements as you go so you can see real numbers, not guesses.',
  },
  {
    q: 'Is it FDA-cleared?',
    a: 'Yes. The invisa-RED ELITE received FDA 510(k) clearance (K192275) as a non-invasive aesthetic treatment for the temporary reduction of waist, hip and thigh circumference.',
  },
  {
    q: 'Who should not use invisa-RED?',
    a: 'Treatment is not recommended if you are pregnant, trying to become pregnant or nursing. If you have a pacemaker, a history of cancer, a light-sensitive condition or take photosensitizing medication, let us know — we review your health history at the consultation to make sure it\'s a good fit.',
  },
  {
    q: 'I live in Lubbock, Clovis or a nearby town. Is it worth the drive?',
    a: 'Our clients come from all over the area — Littlefield, Friona, Farwell, Sudan, Earth and beyond. Sessions are short, parking is easy, and you skip big-city waiting rooms.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['HealthAndBeautyBusiness', 'MedicalBusiness'],
    '@id': `${site.url}/#business`,
    name: site.name,
    url: site.url,
    telephone: site.phone,
    image: `${site.url}/og-image.jpg`,
    description,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.street,
      addressLocality: site.city,
      addressRegion: site.region,
      postalCode: site.zip,
      addressCountry: 'US',
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    areaServed: site.serviceArea.map((c) => ({ '@type': 'City', name: `${c}` })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'invisa-RED laser treatments',
      itemListElement: [
        'Red light therapy for weight loss',
        'Non-invasive body contouring & inch loss',
        'Cellulite reduction',
        'Skin tightening',
      ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const benefits = [
  {
    img: weight,
    alt: 'Woman holding a bathroom scale after red light therapy weight loss sessions',
    tag: 'Weight loss support',
    title: 'Give your weight-loss plan a head start',
    body: 'Laser energy helps fat cells release what they\'ve been holding onto so your body can use it as fuel. Paired with simple daily habits, it helps the scale — and the tape measure — finally move.',
  },
  {
    img: waist,
    alt: 'Slim waistline showing the result of non-invasive laser body contouring',
    tag: 'Body contouring',
    title: 'Target the stubborn spots',
    body: 'Belly, flanks, hips, thighs, arms, back and under the chin — the places that ignore crunches and cardio. Each area is treated with flexible laser paddles shaped to your body.',
  },
  {
    img: cellulite,
    alt: 'Smooth skin on the back of the thighs after cellulite reduction treatment',
    tag: 'Cellulite',
    title: 'Smoother-looking skin',
    body: 'Cellulite affects the vast majority of women and plenty of men. By shrinking the fat cells just under the skin and supporting circulation, treatments help soften that dimpled look.',
  },
  {
    img: arm,
    alt: 'Toned upper arm after laser skin tightening',
    tag: 'Skin tightening',
    title: 'Firmer, tighter skin as you lose',
    body: 'Red and infrared light encourage collagen and elastin production, helping skin tighten as inches come off — a big deal for arms, tummies and after major weight loss.',
  },
];
---
<Base title={title} description={description} schema={schema}>
  <!-- Header -->
  <header class="absolute inset-x-0 top-0 z-30">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8">
      <a href="/" class="group flex items-center gap-3" aria-label="Muleshoe Body Studio home">
        <span class="relative grid h-10 w-10 place-items-center rounded-full bg-ember text-white shadow-[0_0_30px_rgba(255,107,79,.6)]">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </span>
        <span class="leading-none text-bone">
          <span class="block font-display text-xl tracking-tight">Muleshoe</span>
          <span class="block text-[.7rem] font-semibold uppercase tracking-[.32em] text-bone/70">Body Studio</span>
        </span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-bone/80 md:flex" aria-label="Main">
        <a href="#how-it-works" class="hover:text-white">How it works</a>
        <a href="#results" class="hover:text-white">Results</a>
        <a href="#your-visit" class="hover:text-white">Your visit</a>
        <a href="#faq" class="hover:text-white">FAQ</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href={site.phoneHref} class="hidden text-sm font-semibold text-bone/90 hover:text-white sm:block">{site.phone}</a>
        <a href="#book" class="rounded-full bg-bone px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Book now</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="grain relative overflow-hidden bg-ink pb-24 pt-32 text-bone sm:pt-40 lg:pb-32">
      <div class="glow pointer-events-none absolute -right-40 top-10 h-[46rem] w-[46rem] opacity-90"></div>
      <div class="glow-soft pointer-events-none absolute -left-40 bottom-0 h-[30rem] w-[30rem]"></div>

      <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.15fr_.85fr]">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-bone/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[.2em] text-blush">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-glow"></span> Now open in Muleshoe, Texas
          </p>
          <h1 class="mt-6 font-display text-[2.7rem] leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.6rem]">
            Lose inches with <em class="not-italic text-glow">red light</em>, not surgery.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone/75">
            Muleshoe Body Studio brings the FDA-cleared <strong class="font-semibold text-bone">invisa-RED™ laser</strong> to the South Plains — red light therapy for weight loss, non-invasive fat reduction, cellulite and skin tightening. No needles. No downtime. Just 15–20 minutes of warm, relaxing light.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#book" class="inline-flex items-center justify-center rounded-full bg-ember px-7 py-4 font-semibold text-white shadow-[0_18px_50px_-14px_rgba(255,107,79,.9)] transition hover:bg-glow">Book a free consultation</a>
            <a href="#how-it-works" class="inline-flex items-center justify-center rounded-full border border-bone/20 px-7 py-4 font-semibold text-bone transition hover:border-bone/50 hover:bg-white/5">See how it works</a>
          </div>
          <dl class="mt-12 grid max-w-lg grid-cols-3 gap-4 sm:gap-6 border-t border-bone/10 pt-8">
            <div><dt class="text-xs uppercase tracking-[.16em] text-bone/50">Session</dt><dd class="mt-1 font-display text-xl sm:text-2xl">15–20 min</dd></div>
            <div><dt class="text-xs uppercase tracking-[.16em] text-bone/50">Downtime</dt><dd class="mt-1 font-display text-xl sm:text-2xl">None</dd></div>
            <div><dt class="text-xs uppercase tracking-[.16em] text-bone/50">Wavelengths</dt><dd class="mt-1 font-display text-xl sm:text-2xl">680 + 980nm</dd></div>
          </dl>
        </div>

        <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
          <div class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[3rem] rounded-tr-[9rem] bg-gradient-to-b from-[#3a2a24] to-ink-2 ring-1 ring-bone/10">
            <div class="glow absolute inset-x-0 bottom-0 mx-auto h-72 w-72"></div>
            <Image src={device} alt="invisa-RED ELITE red light laser body contouring device at Muleshoe Body Studio" class="relative mx-auto h-full w-auto object-contain py-8 drop-shadow-[0_30px_40px_rgba(0,0,0,.5)]" widths={[300, 500, 700]} sizes="(min-width: 1024px) 420px, 80vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="absolute -bottom-6 -left-2 rounded-2xl bg-bone px-5 py-4 text-ink shadow-2xl sm:-left-8">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-clay">FDA 510(k) cleared</p>
            <p class="mt-1 font-display text-lg leading-tight">invisa-RED™ ELITE</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro / local -->
    <section class="relative py-24 sm:py-28">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
        <div class="reveal relative">
          <div class="overflow-hidden rounded-[2.5rem] rounded-bl-[7rem]">
            <Image src={studio} alt="invisa-RED laser for non-invasive fat reduction inside the Muleshoe studio" class="aspect-[4/5] w-full object-cover" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 600px, 100vw" />
          </div>
          <div class="absolute -right-3 bottom-10 max-w-[15rem] rounded-2xl bg-ink p-5 text-bone shadow-xl sm:-right-8">
            <p class="font-display text-3xl text-glow">0</p>
            <p class="mt-1 text-sm text-bone/70">needles, incisions or recovery days</p>
          </div>
        </div>
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-clay">Body contouring, close to home</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">You shouldn't have to drive to Lubbock to feel good in your skin.</h2>
          <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink/75">
            <p>For a lot of folks around Bailey County, non-invasive fat reduction meant a long drive, a big-city price tag, or just doing without. We wanted something better for our neighbors.</p>
            <p>Muleshoe Body Studio is a calm, private space built around one proven piece of technology: the invisa-RED™ laser. It's for the mom who's tried every plan, the rancher who wants to lose the belly before his check-up, and anyone who has done the work but still can't budge that last stubborn spot.</p>
            <p>Lie back, relax under warm red light, and let your body do the rest.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2 text-sm">
            {['Men & women', 'Weight loss', 'Inch loss', 'Cellulite', 'Skin tightening', 'Private suite'].map((t) => (
              <span class="rounded-full bg-sand px-4 py-1.5 font-medium text-ink/80">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="grain relative overflow-hidden bg-ink-2 py-24 text-bone sm:py-32">
      <div class="glow-soft pointer-events-none absolute right-0 top-0 h-[40rem] w-[40rem]"></div>
      <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-blush">The science, simply</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">How red light laser therapy helps your body let go of fat</h2>
          <p class="mt-6 text-lg leading-relaxed text-bone/70">The fat just under your skin is the last place your body pulls energy from — which is why it hangs around no matter how many salads you eat. invisa-RED uses two laser wavelengths to wake those cells up.</p>
        </div>

        <ol class="mt-16 grid gap-6 md:grid-cols-3">
          {[
            ['01', 'Light reaches the fat layer', 'Red (680nm) and infrared (980nm) laser diodes in soft paddles deliver gentle, pulsed light through the skin to the fat cells beneath. You feel warmth — nothing more.'],
            ['02', 'Fat cells release their stores', 'The light energizes the cell\'s mitochondria (a process called photobiomodulation), signaling enlarged fat cells to release stored fat, water and waste. The cells shrink; they aren\'t destroyed.'],
            ['03', 'Your body burns & clears it', 'Released fat is used for energy and the rest is carried out through your lymphatic system. Drinking water and moving after your session helps your body finish the job.'],
          ].map(([n, h, p]) => (
            <li class="reveal relative rounded-[2rem] border border-bone/10 bg-white/[.03] p-8">
              <span class="font-display text-5xl text-glow/90">{n}</span>
              <div class="beam my-6 w-24"></div>
              <h3 class="font-display text-2xl">{h}</h3>
              <p class="mt-3 leading-relaxed text-bone/70">{p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[.2em] text-clay">What it treats</p>
            <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">One laser. Four ways to feel more like you.</h2>
          </div>
          <p class="max-w-md text-lg text-ink/70">Whether your goal is weight loss, a smaller waistline or smoother skin, we build your plan around the result you care about most.</p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {benefits.map((b, i) => (
            <article class={`reveal group grid overflow-hidden rounded-[2rem] bg-white ring-1 ring-ink/5 sm:grid-cols-[.8fr_1fr] ${i % 2 ? 'md:translate-y-10' : ''}`}>
              <div class="relative min-h-56 overflow-hidden bg-gradient-to-br from-blush to-sand">
                <Image src={b.img} alt={b.alt} class="absolute inset-0 h-full w-full object-cover object-center transition duration-700 group-hover:scale-105" widths={[300, 500]} sizes="(min-width: 768px) 260px, 100vw" />
              </div>
              <div class="p-7">
                <span class="text-xs font-semibold uppercase tracking-[.18em] text-ember">{b.tag}</span>
                <h3 class="mt-3 font-display text-2xl leading-snug">{b.title}</h3>
                <p class="mt-3 leading-relaxed text-ink/70">{b.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Results / clinical -->
    <section id="results" class="relative overflow-hidden bg-sand py-24 sm:py-32">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-clay">Backed by a clinical trial</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">Real research, not just before-and-after hype</h2>
          <p class="mt-6 text-lg leading-relaxed text-ink/75">invisa-RED was tested in a randomized, double-blind, sham-controlled trial — the gold standard for medical research — and cleared by the FDA for non-invasive, temporary reduction of waist, hip and thigh circumference. Participants made <em>no</em> changes to diet or exercise.</p>

          <div class="mt-10 grid grid-cols-2 gap-4">
            <div class="rounded-3xl bg-bone p-6">
              <p class="font-display text-5xl text-ember">10.16″</p>
              <p class="mt-2 text-sm text-ink/70">average total inches lost across measured areas</p>
            </div>
            <div class="rounded-3xl bg-bone p-6">
              <p class="font-display text-5xl text-ember">9</p>
              <p class="mt-2 text-sm text-ink/70">treatments in the study protocol</p>
            </div>
            <div class="rounded-3xl bg-bone p-6">
              <p class="font-display text-5xl text-ember">4.5 lb</p>
              <p class="mt-2 text-sm text-ink/70">average body fat lost, about ½ lb per session</p>
            </div>
            <div class="rounded-3xl bg-bone p-6">
              <p class="font-display text-5xl text-ember">0</p>
              <p class="mt-2 text-sm text-ink/70">adverse reactions reported</p>
            </div>
          </div>
          <p class="mt-5 text-xs leading-relaxed text-ink/55">Results reported by the manufacturer from clinical trial NCT03811093. FDA 510(k) K192275. Individual results vary and are not guaranteed.</p>
        </div>
        <div class="reveal relative">
          <div class="glow absolute inset-0 m-auto h-3/4 w-3/4 opacity-60"></div>
          <Image src={consoleImg} alt="invisa-RED ELITE touchscreen console used for red light weight loss treatments" class="relative w-full rounded-[2.5rem] shadow-2xl" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 560px, 100vw" />
        </div>
      </div>
    </section>

    <!-- Your visit -->
    <section id="your-visit" class="py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-clay">What to expect</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">From first visit to your goal</h2>
        </div>
        <div class="relative mt-16">
          <div class="beam absolute left-0 right-0 top-7 hidden md:block"></div>
          <ol class="grid gap-10 md:grid-cols-4">
            {[
              ['Free consultation', 'We talk through your goals and health history, take starting measurements and recommend a plan that fits your schedule and budget.'],
              ['Relax under the light', 'Lie back while the laser paddles rest over your treatment area for 15–20 minutes. Bring headphones, scroll your phone or just rest.'],
              ['Stay consistent', '2–3 sessions per week keeps your body in fat-burning mode. Drink plenty of water and take a walk afterward to help flush released fat.'],
              ['Measure & maintain', 'We re-measure as you go. Once you hit your goal, one or two touch-up sessions a month help you hold your results.'],
            ].map(([h, p], i) => (
              <li class="reveal relative">
                <span class="relative z-10 grid h-14 w-14 place-items-center rounded-full bg-ink font-display text-xl text-bone ring-8 ring-bone">{i + 1}</span>
                <h3 class="mt-6 font-display text-2xl">{h}</h3>
                <p class="mt-3 leading-relaxed text-ink/70">{p}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="reveal mt-16 grid gap-4 rounded-[2rem] bg-white p-8 ring-1 ring-ink/5 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h3 class="font-display text-2xl">Is invisa-RED right for me?</h3>
            <p class="mt-2 max-w-3xl text-ink/70">Great for healthy adults who want to lose weight, lose inches or firm up problem areas. It's not recommended during pregnancy or while nursing, and we'll review conditions like pacemakers, cancer history or light sensitivity at your consultation.</p>
          </div>
          <a href="#book" class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3.5 font-semibold text-bone transition hover:bg-ember">Ask us at your free consult</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white py-24 sm:py-32">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr]">
        <div class="reveal lg:sticky lg:top-10 lg:self-start">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-clay">Questions</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">Red light therapy, answered</h2>
          <p class="mt-5 text-lg text-ink/70">Still wondering about something? Give us a call at <a href={site.phoneHref} class="font-semibold text-ember underline-offset-4 hover:underline">{site.phone}</a> — we're happy to talk it through.</p>
        </div>
        <div class="divide-y divide-ink/10 border-y border-ink/10">
          {faqs.map((f) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-xl leading-snug">
                {f.q}
                <span class="faq-icon mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sand text-ember transition">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-4 max-w-2xl leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Booking -->
    <section id="book" class="grain relative overflow-hidden bg-ink py-24 text-bone sm:py-32">
      <div class="glow pointer-events-none absolute -left-40 top-20 h-[40rem] w-[40rem] opacity-70"></div>
      <div class="relative mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-blush">Book your time</p>
          <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">Your first step is free.</h2>
          <p class="mt-6 text-lg leading-relaxed text-bone/75">New to red light body contouring? Start with a free consultation. Already a client? Request your next session on the invisa-RED and we'll lock in your time.</p>

          <div class="mt-10 space-y-6">
            <div class="flex gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/5 ring-1 ring-bone/15">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>
              </span>
              <div>
                <p class="font-semibold">Visit the studio</p>
                <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-bone/70 hover:text-white">{site.street}<br />{site.city}, {site.region} {site.zip}</a>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/5 ring-1 ring-bone/15">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <p class="font-semibold">Call or text</p>
                <a href={site.phoneHref} class="text-bone/70 hover:text-white">{site.phone}</a>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/5 ring-1 ring-bone/15">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <div>
                <p class="font-semibold">Hours</p>
                <p class="text-bone/70">{site.hours}</p>
              </div>
            </div>
          </div>

          <p class="mt-10 text-sm leading-relaxed text-bone/50">Proudly serving {site.serviceArea.slice(0, -1).join(', ')} and {site.serviceArea.at(-1)}.</p>
        </div>

        <div class="reveal text-ink">
          <BookingForm />
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-bone/60">
    <div class="beam"></div>
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 text-sm sm:px-8 md:flex-row md:items-center md:justify-between">
      <p><span class="font-display text-base text-bone">Muleshoe Body Studio</span> · {site.street}, {site.city}, {site.region} {site.zip} · <a href={site.phoneHref} class="hover:text-white">{site.phone}</a></p>
      <p>© {new Date().getFullYear()} Muleshoe Body Studio. All rights reserved.</p>
    </div>
    <p class="mx-auto max-w-7xl px-5 pb-10 text-xs leading-relaxed text-bone/40 sm:px-8">invisa-RED™ is a trademark of IR Technology, LLC. The invisa-RED ELITE is FDA-cleared as a non-invasive dermatological aesthetic treatment for the temporary reduction of waist, hip and thigh circumference. Results vary by individual. This website is for informational purposes and is not medical advice.</p>
  </footer>

  <!-- Mobile sticky CTA -->
  <div class="fixed inset-x-3 bottom-3 z-40 flex gap-2 md:hidden">
    <a href={site.phoneHref} class="flex-1 rounded-full bg-bone/95 py-3.5 text-center text-sm font-semibold text-ink shadow-xl ring-1 ring-ink/10 backdrop-blur">Call</a>
    <a href="#book" class="flex-[2] rounded-full bg-ember py-3.5 text-center text-sm font-semibold text-white shadow-xl">Book free consult</a>
  </div>
</Base>
